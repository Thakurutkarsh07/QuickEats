# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://quickeatsdb:dbquickeats@quickeats.qfuon.mongodb.net/quick-eats

# JWT Configuration - Generate a strong secret key in production
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-for-production

# Payment Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-secret-key

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
